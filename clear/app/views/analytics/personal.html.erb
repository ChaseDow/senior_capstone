<% content_for :page_title, "Analytics" %>
<% content_for :page_subtitle, "Your personal dashboard" %>

<%= render "analytics/tabs", active: :personal %>

<%# Header bar %>
<div class="flex items-center justify-between mb-5">
  <div>
    <h2 class="text-sm font-semibold text-zinc-200">My Dashboard</h2>
    <p class="text-xs text-zinc-500 mt-0.5">Drag, resize, and arrange widgets. Layout saves automatically.</p>
  </div>
  <%= link_to picker_widget_configs_path,
        class: "studs-btn-accent",
        data: { turbo_frame: "widget_modal" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/>
    </svg>
    Add widget
  <% end %>
</div>

<%# Modal — toggled by the existing modal_controller via syncWithFrame %>
<div data-controller="modal" class="relative z-50">
  <div data-modal-target="overlay"
       data-action="click->modal#close"
       class="fixed inset-0 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"></div>

  <div class="fixed inset-0 flex items-start justify-center p-4 sm:p-8 pointer-events-none">
    <div data-modal-target="panel"
         class="relative w-full max-w-2xl rounded-2xl shadow-2xl opacity-0 scale-95 pointer-events-none transition-all duration-200 mt-12 sm:mt-20"
         style="background-color: var(--studs-panel-bg); border: 1px solid var(--studs-border);">
      <button type="button"
              data-action="click->modal#close"
              class="absolute top-3 right-3 z-10 rounded-lg p-1.5 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60 transition-colors"
              aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      <%= turbo_frame_tag "widget_modal", data: { modal_target: "frame" } %>
    </div>
  </div>
</div>

<%# Gridstack container %>
<% if @widget_configs.empty? %>
  <div id="personal_widgets_empty"
       class="rounded-2xl p-12 flex flex-col items-center justify-center text-center"
       style="border: 1px dashed var(--studs-border); background-color: var(--studs-panel-bg);">
    <div class="opacity-30 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 8.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
      </svg>
    </div>
    <p class="text-sm font-semibold text-zinc-300 mb-1">No widgets yet</p>
    <p class="text-xs text-zinc-500 mb-4">Add a widget to start tracking events you care about.</p>
    <p class="text-[11px] text-zinc-600 max-w-sm">
      Mark an event as <span class="text-zinc-400 font-medium">trackable</span> in its edit form to make it available for personal widgets.
    </p>
  </div>
<% end %>

<div id="personal_widgets_grid"
     class="grid-stack"
     data-controller="widget-grid"
     data-widget-grid-reorder-url-value="<%= reorder_widget_configs_path %>">
  <% @widget_configs.each do |wc| %>
    <%= render "widget_configs/grid_item", widget: wc %>
  <% end %>
</div>
