<%# Used as a layout. Locals: widget_config, trackable_events. %>
<%= turbo_frame_tag "widget_modal" do %>
  <div class="p-6 max-h-[80vh] overflow-y-auto">
    <h3 class="text-base font-semibold text-zinc-100 mb-1">
      Configure <%= WidgetConfig::WIDGET_TYPES.find { |t| t[:key] == widget_config.widget_type }&.dig(:label) %>
    </h3>
    <p class="text-xs text-zinc-500 mb-5">Set up how this widget will display your data.</p>

    <% if widget_config.errors.any? %>
      <div class="rounded-2xl p-4 mb-4 text-red-300"
           style="border: 1px solid rgba(239,68,68,0.3); background-color: rgba(127,29,29,0.2);">
        <p class="text-sm font-semibold mb-1">Please fix the following:</p>
        <ul class="list-disc pl-5 text-sm space-y-0.5">
          <% widget_config.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <% label_classes = "block text-[10px] font-bold uppercase tracking-widest mb-1.5" %>
    <% label_style   = "color: var(--studs-accent); opacity: 0.8;" %>
    <% input_classes = "w-full rounded-2xl px-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-600 " \
                       "bg-zinc-950/60 focus:outline-none focus:ring-2 transition-all duration-150 border" %>
    <% input_style   = "border-color: var(--studs-border); --tw-ring-color: var(--studs-accent);" %>

    <%= form_with model: widget_config,
                  url: widget_configs_path,
                  class: "space-y-5" do |f| %>
      <%= f.hidden_field :widget_type %>

      <%# Title %>
      <div>
        <%= f.label :title, class: label_classes, style: label_style do %>Title <span class="text-red-400">*</span><% end %>
        <%= f.text_field :title, class: input_classes, style: input_style, placeholder: "e.g. Workouts this month" %>
      </div>

      <%# Event selector %>
      <div>
        <label class="<%= label_classes %>" style="<%= label_style %>">Trackable events</label>
        <% if trackable_events.any? %>
          <div class="rounded-2xl p-3 max-h-44 overflow-y-auto space-y-1.5"
               style="border: 1px solid var(--studs-border); background-color: var(--studs-panel-bg-2);">
            <% trackable_events.each do |ev| %>
              <% checked = widget_config.event_ids.include?(ev.id) %>
              <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-zinc-800/40">
                <%= check_box_tag "widget_config[config][event_ids][]", ev.id, checked,
                      id: "wc_ev_#{ev.id}",
                      class: "h-4 w-4 rounded cursor-pointer",
                      style: "accent-color: var(--studs-accent);" %>
                <span class="h-2 w-2 rounded-full shrink-0" style="background-color: <%= ev.color %>;"></span>
                <span class="text-sm text-zinc-200 truncate"><%= ev.title %></span>
              </label>
            <% end %>
          </div>
          <p class="text-[11px] text-zinc-500 mt-1.5">Check the events this widget should track.</p>
        <% else %>
          <div class="rounded-2xl p-4 text-center"
               style="border: 1px dashed var(--studs-border); background-color: var(--studs-panel-bg-2);">
            <p class="text-sm text-zinc-400 mb-1">No trackable events yet</p>
            <p class="text-[11px] text-zinc-600">Mark an event as trackable in its edit form to make it available here.</p>
          </div>
        <% end %>
      </div>

      <%# Date range %>
      <div>
        <label for="wc_date_range" class="<%= label_classes %>" style="<%= label_style %>">Date range</label>
        <select id="wc_date_range" name="widget_config[config][date_range]"
                class="<%= input_classes %>" style="<%= input_style %>">
          <% WidgetConfig::DATE_RANGES.each do |key, opts| %>
            <option value="<%= key %>" <%= "selected" if widget_config.config["date_range"].to_s == key || (widget_config.config["date_range"].blank? && key == "30") %>>
              <%= opts[:label] %>
            </option>
          <% end %>
        </select>
      </div>

      <%# Type-specific fields %>
      <%= yield f if block_given? %>

      <%# Accent color %>
      <div>
        <label for="wc_color" class="<%= label_classes %>" style="<%= label_style %>">Accent color</label>
        <div class="flex items-center gap-3">
          <input type="color" id="wc_color"
                 name="widget_config[config][color]"
                 value="<%= widget_config.accent_color %>"
                 class="h-12 w-20 cursor-pointer rounded-xl border bg-zinc-950/40"
                 style="border-color: var(--studs-border);">
          <span class="text-xs text-zinc-500">Used as the primary highlight color.</span>
        </div>
      </div>

      <%# Submit %>
      <div class="flex items-center gap-3 pt-4" style="border-top: 1px solid var(--studs-divider);">
        <button type="submit" class="studs-btn-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          Add to dashboard
        </button>
        <button type="button" class="studs-nav-btn" data-action="click->modal#close">Cancel</button>
      </div>
    <% end %>
  </div>
<% end %>
