<%# locals: (widget:) %>
<%
  days        = widget.date_range_days
  range_start = days.days.ago.to_date
  range_end   = Date.current
  occurrences = widget.user.event_occurrences
                      .where(event_id: widget.event_ids, completed: true)
                      .where(occurred_on: range_start..range_end)

  buckets   = occurrences.group(:occurred_on).count
  bar_count = [ days, 30 ].min
  step      = (days.to_f / bar_count).ceil
  bars      = []
  bar_count.times do |i|
    bucket_start = range_end - ((bar_count - 1 - i) * step)
    bucket_end   = bucket_start + step - 1
    count = (bucket_start..bucket_end).sum { |d| buckets[d].to_i }
    bars << { label: bucket_start.strftime("%-m/%-d"), count: count }
  end
  max_count = [ bars.map { |b| b[:count] }.max.to_i, 1 ].max
  total     = bars.sum { |b| b[:count] }
%>

<%= render layout: "widget_configs/widget_chrome", locals: { widget: widget } do %>
  <% if widget.event_ids.empty? %>
    <p class="text-xs text-zinc-500">No events selected — edit this widget to choose events.</p>
  <% elsif total.zero? %>
    <p class="text-xs text-zinc-500">No completions in the last <%= days %> days.</p>
  <% else %>
    <div class="flex flex-col h-full">
      <div class="flex items-baseline gap-2 mb-2 shrink-0">
        <span class="text-xl font-bold text-zinc-100"><%= total %></span>
        <span class="text-[10px] font-medium text-zinc-500">completions · last <%= days %> days</span>
      </div>
      <div class="flex-1 min-h-0 flex items-end gap-px">
        <% bars.each do |bar| %>
          <div class="flex-1 flex flex-col items-center justify-end h-full min-w-0" title="<%= bar[:label] %>: <%= bar[:count] %>">
            <div class="w-full rounded-t-sm transition-all"
                 style="height: <%= [ (bar[:count].to_f / max_count * 100), 4 ].max %>%;
                        background-color: <%= widget.accent_color %>;
                        opacity: <%= bar[:count].zero? ? 0.18 : 0.85 %>;"></div>
          </div>
        <% end %>
      </div>
      <div class="flex justify-between mt-1 shrink-0">
        <span class="text-[9px] text-zinc-600"><%= bars.first[:label] %></span>
        <span class="text-[9px] text-zinc-600"><%= bars.last[:label] %></span>
      </div>
    </div>
  <% end %>
<% end %>
