<%# Locals: widget %>
<%
  days        = widget.date_range_days
  range_start = days.days.ago.to_date
  range_end   = Date.current

  events_by_id = widget.events.index_by(&:id)
  totals = widget.user.event_occurrences
                 .where(event_id: widget.event_ids, completed: true)
                 .where(occurred_on: range_start..range_end)
                 .group(:event_id)
                 .count

  slices = widget.event_ids.filter_map do |id|
    event = events_by_id[id]
    next unless event
    { id: id, label: event.title, color: event.color, count: totals[id].to_i }
  end

  total = slices.sum { |s| s[:count] }
%>

<%= render layout: "widget_configs/widget_chrome", locals: { widget: widget } do %>
  <% if slices.empty? %>
    <p class="text-xs text-zinc-500">No events selected — edit this widget to choose events.</p>
  <% elsif total.zero? %>
    <div class="flex flex-col items-center justify-center h-full text-center">
      <p class="text-xs text-zinc-400">No completions in the last <%= days %> days.</p>
      <p class="text-[10px] text-zinc-600 mt-1">Mark occurrences complete to populate this chart.</p>
    </div>
  <% else %>
    <%
      cx = 50
      cy = 50
      r  = 42
      circumference = 2 * Math::PI * r

      cumulative = 0.0
    %>
    <div class="flex items-center gap-4 h-full">
      <div class="shrink-0">
        <svg viewBox="0 0 100 100" class="h-32 w-32" style="transform: rotate(-90deg);">
          <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= r %>"
                  fill="none" stroke="<%= widget.accent_color %>" stroke-opacity="0.12" stroke-width="16"/>
          <% slices.each do |s|
               next if s[:count].zero?
               frac = s[:count].to_f / total
               dash = (frac * circumference).round(2)
               gap  = (circumference - dash).round(2)
               offset = (-cumulative * circumference).round(2)
               cumulative += frac
          %>
            <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= r %>"
                    fill="none" stroke="<%= s[:color] %>" stroke-width="16"
                    stroke-dasharray="<%= dash %> <%= gap %>"
                    stroke-dashoffset="<%= offset %>">
              <title><%= s[:label] %>: <%= s[:count] %> (<%= (frac * 100).round %>%)</title>
            </circle>
          <% end %>
        </svg>
      </div>
      <div class="flex-1 min-w-0 space-y-1.5 overflow-y-auto">
        <% slices.sort_by { |s| -s[:count] }.each do |s| %>
          <% pct = (s[:count].to_f / total * 100).round %>
          <div class="flex items-center gap-2 text-xs">
            <span class="h-2.5 w-2.5 rounded-sm shrink-0" style="background-color: <%= s[:color] %>;"></span>
            <span class="truncate text-zinc-200 flex-1"><%= s[:label] %></span>
            <span class="text-zinc-400 tabular-nums"><%= s[:count] %></span>
            <span class="text-[10px] text-zinc-500 tabular-nums w-9 text-right"><%= pct %>%</span>
          </div>
        <% end %>
        <p class="text-[10px] text-zinc-500 pt-1">Last <%= days %> days · <%= total %> total</p>
      </div>
    </div>
  <% end %>
<% end %>
