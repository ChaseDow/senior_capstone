<%# locals: (widget:) %>
<%
  days        = widget.date_range_days
  range_start = days.days.ago.to_date
  range_end   = Date.current
  scope       = widget.user.event_occurrences
                      .where(event_id: widget.event_ids)
                      .where(occurred_on: range_start..range_end, completed: true)

  case widget.stat_metric
  when "total_hours"
    value      = (scope.sum(:duration_minutes).to_f / 60).round(1)
    label      = "hours · last #{days} days"
  when "current_streak"
    days_done  = scope.distinct.pluck(:occurred_on).to_set
    streak     = 0
    cursor     = Date.current
    while days_done.include?(cursor)
      streak += 1
      cursor -= 1
    end
    value      = streak
    label      = streak == 1 ? "day streak" : "day streak"
  else
    value      = scope.count
    label      = "completions · last #{days} days"
  end
%>

<%= render layout: "widget_configs/widget_chrome", locals: { widget: widget } do %>
  <% if widget.event_ids.empty? %>
    <p class="text-xs text-zinc-500">No events selected — edit this widget to choose events.</p>
  <% else %>
    <div class="flex flex-col items-center justify-center h-full text-center">
      <span class="text-4xl font-bold leading-none" style="color: <%= widget.accent_color %>;">
        <%= value %>
      </span>
      <span class="text-[10px] font-medium text-zinc-500 mt-2 uppercase tracking-wider"><%= label %></span>
    </div>
  <% end %>
<% end %>
