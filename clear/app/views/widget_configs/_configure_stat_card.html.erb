<% label_classes = "block text-[10px] font-bold uppercase tracking-widest mb-1.5" %>
<% label_style   = "color: var(--studs-accent); opacity: 0.8;" %>
<% input_classes = "w-full rounded-2xl px-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-600 " \
                   "bg-zinc-950/60 focus:outline-none focus:ring-2 transition-all duration-150 border" %>
<% input_style   = "border-color: var(--studs-border); --tw-ring-color: var(--studs-accent);" %>

<%= render layout: "widget_configs/form_shell",
            locals: { widget_config: @widget_config, trackable_events: @trackable_events } do |_f| %>
  <div>
    <label for="wc_stat_metric" class="<%= label_classes %>" style="<%= label_style %>">Metric</label>
    <select id="wc_stat_metric" name="widget_config[config][stat_metric]"
            class="<%= input_classes %>" style="<%= input_style %>">
      <% [
        [ "total_completions", "Total completions" ],
        [ "total_hours",       "Total hours" ],
        [ "current_streak",    "Current streak (days)" ]
      ].each do |val, label| %>
        <option value="<%= val %>" <%= "selected" if @widget_config.stat_metric == val %>><%= label %></option>
      <% end %>
    </select>
  </div>
<% end %>
