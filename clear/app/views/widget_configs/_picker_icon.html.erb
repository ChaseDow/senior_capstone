<%# locals: (key:) — returns inline SVG for a widget type %>
<% case key
   when "bar_chart" %>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V10m6 11V4m6 17v-7m6 7v-13"/>
  </svg>
<% when "line_chart" %>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 17l5-6 4 4 8-10"/>
  </svg>
<% when "progress_bar" %>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <rect x="3" y="9" width="18" height="6" rx="3"/>
    <rect x="3" y="9" width="11" height="6" rx="3" fill="currentColor" stroke="none"/>
  </svg>
<% when "stat_card" %>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 9h16M4 15h16M9 4l-2 16M17 4l-2 16"/>
  </svg>
<% when "heatmap" %>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <rect x="3" y="3" width="6" height="6" rx="1"/>
    <rect x="11" y="3" width="6" height="6" rx="1" fill="currentColor" stroke="none"/>
    <rect x="3" y="11" width="6" height="6" rx="1" fill="currentColor" stroke="none" opacity="0.5"/>
    <rect x="11" y="11" width="6" height="6" rx="1"/>
  </svg>
<% end %>
